# Agent image — OpenClaw Tor P2P Node
# Symmetry Labs Infrastructure
FROM python:3.12-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --system --uid 1000 --no-create-home --shell /usr/sbin/nologin agent

# Install Python dependencies
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY agent.py .
COPY cli.py .

# Persistent data dir (mounted as volume)
RUN mkdir -p /var/lib/oc-tor-net && chown agent:agent /var/lib/oc-tor-net

USER agent

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8765 9090

CMD ["python3", "/app/agent.py"]
