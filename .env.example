# OpenClaw Tor P2P Node — Environment Variables
# Copy to .env and fill in real values before running:
#   cp .env.example .env
#
# IMPORTANT: Production deployments use Docker secrets (see secrets/README.md).
# The variables below are only used as fallbacks when secrets files are absent
# (e.g. local development without the secrets/ directory).

# Anthropic Claude model (optional — override the default)
ANTHROPIC_MODEL=claude-sonnet-4-5
