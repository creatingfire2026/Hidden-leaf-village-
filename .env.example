# OpenClaw Tor P2P Node — Environment Variables
# Copy to .env and fill in real values before running:
#   cp .env.example .env

# Redis password (change this in production!)
REDIS_PASSWORD=changeme-in-production

# Grafana admin password
GRAFANA_PASSWORD=changeme

# Anthropic Claude API key (optional — AI features disabled when absent)
ANTHROPIC_API_KEY=
